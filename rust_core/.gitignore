# .gitignore for Rust project

# Rust
/target/
# Cargo.lock is deliberately absent from this list: the crate is a shipped binary
# artifact (the accelerator compiled into every released engine), not a library.
# While it was ignored, each release re-resolved Cargo.toml's caret ranges from
# scratch — no release build was reproducible, and a regressed minor crate release
# landed straight in the binary users download.
**/*.rs.bk
*.pdb

# Python
*.pyc
__pycache__/
*.so
*.pyd
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
