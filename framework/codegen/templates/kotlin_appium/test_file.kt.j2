class {{ class_name }} {

{% if model.platform.value == "ios" %}
    private lateinit var driver: IOSDriver
{% else %}
    private lateinit var driver: AndroidDriver
{% endif %}

    // Condition-based wait budget — poll for elements instead of a fixed sleep or
    // a global implicit wait, so tests stay in sync with async UI.
    private val TIMEOUT: Duration = Duration.ofSeconds(10)

    // Run anywhere without regenerating: point at a different Appium/cloud-grid
    // hub with MOBISCOUT_APPIUM_SERVER.
    private val SERVER: String = System.getenv("MOBISCOUT_APPIUM_SERVER") ?: "http://localhost:4723"

    @BeforeEach
    fun setUp() {
{% if model.platform.value == "ios" %}
        val options = XCUITestOptions()
        options.setPlatformName("iOS")
        options.setAutomationName("XCUITest")
        options.setBundleId({{ model.app_package | kotlin_str }})
{% if model.launch_args %}
        // Launch arguments used during the crawl (e.g. skip a login gate) — pass them
        // so the test starts in the same state the flow was recorded in.
        options.setCapability("processArguments", mapOf("args" to listOf({% for a in model.launch_args %}{{ a | kotlin_str }}{% if not loop.last %}, {% endif %}{% endfor %})))
{% endif %}
        driver = IOSDriver(URL(SERVER), options)
{% else %}
        val options = UiAutomator2Options()
        options.setPlatformName("Android")
        options.setAppPackage({{ model.app_package | kotlin_str }})
{% if model.app_activity %}
        options.setAppActivity({{ model.app_activity | kotlin_str }})
{% endif %}
        driver = AndroidDriver(URL(SERVER), options)
{% endif %}
    }

    @AfterEach
    fun tearDown() {
        driver.quit()
    }

    // How many times find() scrolls looking for an off-screen element before giving up.
    private val SCROLL_TRIES: Int = 4

    /** One pass over the ranked locators — no waiting. */
    private fun locate(context: org.openqa.selenium.SearchContext, locators: List<By>): WebElement? {
        for (by in locators) {
            try {
                return context.findElement(by)
            } catch (ignored: NoSuchElementException) {
            }
        }
        return null
    }

    /** One scroll-down gesture — used by find() to bring a below-the-fold element into view. */
    private fun scrollDown() {
{% if model.platform.value == "ios" %}
        driver.executeScript("mobile: scroll", mapOf<String, Any>("direction" to "down"))
{% else %}
        val scrollSize = driver.manage().window().size
        driver.executeScript("mobile: scrollGesture", mapOf<String, Any>("left" to (scrollSize.width * 0.1).toInt(), "top" to (scrollSize.height * 0.2).toInt(), "width" to (scrollSize.width * 0.8).toInt(), "height" to (scrollSize.height * 0.6).toInt(), "direction" to "down", "percent" to 0.8))
{% endif %}
    }

    /**
     * Locate an element, waiting for it to appear and self-healing through ranked
     * alternatives — a condition-based wait, not an instant lookup that flakes. On a
     * miss, scroll and retry: a control below the fold is not a missing control, and
     * the same crawl must not pass in one target and fail in another over that.
     */
    private fun find(primary: By, fallbacks: Array<By>): WebElement {
        val locators = listOf(primary, *fallbacks)
        try {
            return WebDriverWait(driver, TIMEOUT).until { d -> locate(d, locators) }!!
        } catch (e: TimeoutException) {
        }
        for (i in 0 until SCROLL_TRIES) {
            scrollDown()
            val found = locate(driver, locators)
            if (found != null) {
                return found
            }
        }
        throw NoSuchElementException("No locator matched within ${TIMEOUT.seconds}s + $SCROLL_TRIES scrolls (primary + ${fallbacks.size} fallbacks)")
    }

    // A generic loading indicator (no app-specific knowledge) — used by settle().
    private val BUSY_XPATH: String = {% if model.platform.value == "ios" %}"//XCUIElementTypeActivityIndicator"{% else %}"//android.widget.ProgressBar"{% endif %}

    /**
     * Middle beat of act -> wait-busy-clears -> assert: after an action that triggers
     * a transition, wait for a loading/activity indicator to disappear so the next step
     * doesn't act on a mid-transition screen. No-op when nothing is spinning.
     */
    private fun settle() {
        try {
            WebDriverWait(driver, TIMEOUT).until { d -> d.findElements(By.xpath(BUSY_XPATH)).isEmpty() }
        } catch (ignored: TimeoutException) {
        }
{% if model.platform.value == "android" %}
        // A raised soft keyboard is a transient input surface, not part of the screen under
        // test: with adjustResize it shrinks the layout and can drop a bottom-anchored control
        // (a FAB) out of the accessibility tree, and an IME-occluded control reports
        // isDisplayed() == false. Both flake the next assert on a control that belongs to the
        // screen. Dismiss it so the screen settles deterministically; best-effort.
        try {
            if (driver.isKeyboardShown) {
                driver.hideKeyboard()
            }
        } catch (ignored: Exception) {
        }
{% endif %}
    }

{% for case in model.cases %}
    @Test
    fun {{ case.name | camel }}() {
{% for step in case.steps %}
{% if step.description %}
        // {{ step.description | single_line }}
{% endif %}
{% if step.action.value == "launch" %}
        driver.activateApp({{ model.app_package | kotlin_str }})
{% elif step.action.value == "tap" %}
        find({{ step.selector | by_expr }}, {{ step.selector | by_array }}).click()
{% elif step.action.value == "type" %}
        find({{ step.selector | by_expr }}, {{ step.selector | by_array }}).sendKeys({{ step.text | kotlin_str }})
{% elif step.action.value == "swipe" %}
{% if model.platform.value == "ios" %}
        driver.executeScript("mobile: swipe", mapOf<String, Any>("direction" to {{ (step.direction or "up") | kotlin_str }}))
{% else %}
        run {
            val swipeSize = driver.manage().window().size
            driver.executeScript("mobile: swipeGesture", mapOf<String, Any>("left" to (swipeSize.width * 0.1).toInt(), "top" to (swipeSize.height * 0.1).toInt(), "width" to (swipeSize.width * 0.8).toInt(), "height" to (swipeSize.height * 0.8).toInt(), "direction" to {{ (step.direction or "up") | kotlin_str }}, "percent" to 0.75))
        }
{% endif %}
{% elif step.action.value == "back" %}
        driver.navigate().back()
{% elif step.action.value == "long_press" %}
        org.openqa.selenium.interactions.Actions(driver).clickAndHold(find({{ step.selector | by_expr }}, {{ step.selector | by_array }})).pause(java.time.Duration.ofSeconds(1)).release().perform()
{% elif step.action.value == "scroll_to" %}
{% if model.platform.value == "ios" %}
        driver.executeScript("mobile: scroll", mapOf<String, Any>("predicateString" to {{ ('name == "' ~ ((step.selector.description or step.selector.value) | ua_escape) ~ '" OR label == "' ~ ((step.selector.description or step.selector.value) | ua_escape) ~ '"') | kotlin_str }}, "toVisible" to true))
{% else %}
        driver.findElement(io.appium.java_client.AppiumBy.androidUIAutomator({{ ('new UiScrollable(new UiSelector().scrollable(true)).scrollIntoView(new UiSelector().textContains("' ~ ((step.selector.description or step.selector.value) | ua_escape) ~ '"))') | kotlin_str }}))
{% endif %}
{% elif step.action.value == "deep_link" %}
{% if model.platform.value == "ios" %}
        driver.get({{ step.text | kotlin_str }})
{% else %}
        driver.executeScript("mobile: deepLink", mapOf("url" to {{ step.text | kotlin_str }}, "package" to {{ model.app_package | kotlin_str }}))
{% endif %}
{% elif step.action.value == "press_key" %}
{% if model.platform.value == "ios" %}
        // UNSUPPORTED on iOS: no hardware keycode equivalent for {{ step.text | single_line }}; press the key via the on-screen keyboard instead.
{% else %}
        (driver as io.appium.java_client.android.AndroidDriver).pressKey(io.appium.java_client.android.nativekey.KeyEvent(io.appium.java_client.android.nativekey.AndroidKey.valueOf({{ step.text | upper | kotlin_str }})))
{% endif %}
{% elif step.action.value == "switch_context" %}
{% if step.text == "web" %}
        (driver as io.appium.java_client.remote.SupportsContextSwitching).context(driver.contextHandles.first { it.uppercase().contains("WEBVIEW") })
{% else %}
        (driver as io.appium.java_client.remote.SupportsContextSwitching).context("NATIVE_APP")
{% endif %}
{% elif step.action.value == "wait" %}
        // Condition-based: wait for the screen to render rather than a global implicit wait.
        WebDriverWait(driver, Duration.ofSeconds({{ step.timeout | int or 5 }})).until { d -> d.findElements(By.xpath("//*")).isNotEmpty() }
{% elif step.action.value == "assert" %}
{% if step.assertion.value == "visible" %}
        Assertions.assertTrue(find({{ step.selector | by_expr }}, {{ step.selector | by_array }}).isDisplayed)
{% elif step.assertion.value == "text_equals" %}
        Assertions.assertEquals({{ step.expected | kotlin_str }}, find({{ step.selector | by_expr }}, {{ step.selector | by_array }}).text)
{% elif step.assertion.value == "enabled" %}
        Assertions.assertTrue(find({{ step.selector | by_expr }}, {{ step.selector | by_array }}).isEnabled)
{% endif %}
{% endif %}
{% if step.action.value in ("tap", "type", "swipe", "back", "long_press", "deep_link", "press_key") %}
        settle()
{% endif %}
{% endfor %}
    }

