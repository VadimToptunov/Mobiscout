package mobiscout.support

import io.cucumber.java.Before
import io.cucumber.java.Scenario
import org.opentest4j.TestAbortedException

/**
 * Every scenario starts from a cold restart of the app on the shared [Session]; one tagged for a
 * single platform (`@android` / `@ios`) is skipped on the other.
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
class Hooks {

    @Before(order = 0)
    fun onlyOnItsPlatform(scenario: Scenario) {
        val tags = scenario.sourceTagNames
        if ((tags.contains("@android") || tags.contains("@ios")) && !tags.contains("@${Platform.CURRENT}")) {
            throw TestAbortedException("not for ${Platform.CURRENT}: $tags")
        }
    }

    @Before(order = 1)
    fun restartApp() {
        Session.ensureAlive() // a crashed session costs one scenario, not the rest of the run
        try {
            Session.apps.terminateApp(Session.APP)
        } catch (ignored: RuntimeException) {
            // the app was not running
        }
        Session.apps.activateApp(Session.APP)
    }
}
