package mobiscout.support

import io.cucumber.java.Before

/**
 * Every scenario starts from a cold restart of the app on the shared [Session].
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
class Hooks {

    @Before
    fun restartApp() {
        Session.ensureAlive() // a crashed session costs one test, not the rest of the run
        try {
            Session.driver.terminateApp(Session.APP)
        } catch (ignored: RuntimeException) {
            // the app was not running
        }
        Session.driver.activateApp(Session.APP)
    }
}
