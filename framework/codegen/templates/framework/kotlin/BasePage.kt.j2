package mobiscout.pages

import io.appium.java_client.AppiumBy
import io.appium.java_client.AppiumDriver
import io.appium.java_client.HasOnScreenKeyboard
import io.appium.java_client.HidesKeyboard
import io.appium.java_client.InteractsWithApps
import io.appium.java_client.appmanagement.ApplicationState
import java.time.Duration
import org.openqa.selenium.By
import org.openqa.selenium.NoSuchElementException
import org.openqa.selenium.TimeoutException
import org.openqa.selenium.WebElement
import org.openqa.selenium.support.ui.WebDriverWait

/**
 * Shared behaviour for every page object, written once.
 *
 * Locating is ranked and self-healing (primary locator first, then fallbacks), waits on a
 * condition instead of sleeping (returns the moment the element is there) and scrolls to reach
 * a below-the-fold control. Acting settles the screen afterwards — a loading spinner gone, the
 * soft keyboard dismissed — so the next step never races a transition.
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
abstract class BasePage(protected val driver: AppiumDriver) {

    /** The screen's title, for failure messages. */
    protected abstract val screen: String

    /** The element distinctive to this screen, or `null` when none is. */
    protected abstract val identity: String?

    /** Ranked locators (primary first, then self-healing fallbacks) per element. */
    protected abstract val locators: Map<String, List<By>>

    /** Whether this screen is the one on display, proven by an element only it has. */
    fun isDisplayed(): Boolean {
        val id = identity
            ?: throw UnsupportedOperationException(
                "${this::class.simpleName} has no element distinctive enough to identify it",
            )
        return isVisible(id)
    }

    /** Whether the app under test is still up in the foreground — it did not crash. */
    fun isAppRunning(): Boolean =
        (driver as InteractsWithApps).queryAppState(APP) == ApplicationState.RUNNING_IN_FOREGROUND

    private fun locate(name: String): WebElement? =
        locators.getValue(name).firstNotNullOfOrNull { by -> driver.findElements(by).firstOrNull() }

    /** The element, waiting for it to appear and scrolling to reach it if needed. */
    protected fun find(name: String): WebElement {
        try {
            WebDriverWait(driver, TIMEOUT, POLL).until { locate(name) }?.let { return it }
        } catch (ignored: TimeoutException) {
            // not on screen yet — it may be below the fold
        }
        repeat(SCROLL_TRIES) {
            scrollDown()
            locate(name)?.let { return it }
        }
        throw NoSuchElementException("'$name' not found on the $screen screen within ${TIMEOUT.seconds}s")
    }

    protected fun isVisible(name: String): Boolean =
        try {
            find(name).isDisplayed
        } catch (e: NoSuchElementException) {
            false
        }

    /** Whether the element is absent — returns the moment it is, not after the full timeout. */
    protected fun isGone(name: String): Boolean =
        try {
            WebDriverWait(driver, TIMEOUT, POLL).until { locate(name) == null }
        } catch (e: TimeoutException) {
            false
        }

    protected fun textOf(name: String): String = find(name).text

    protected fun isEnabled(name: String): Boolean = find(name).isEnabled

    protected fun tap(name: String) {
        find(name).click()
        settle()
    }

    protected fun type(name: String, value: String) {
        find(name).apply {
            clear() // replace, don't append to whatever the field held
            sendKeys(value)
        }
        settle()
    }

    private fun settle() {
        try {
            WebDriverWait(driver, SETTLE_TIMEOUT, POLL).until { it.findElements(BUSY).isEmpty() }
        } catch (ignored: TimeoutException) {
            // a stuck spinner is tolerated, not failed
        }
        try {
            if ((driver as? HasOnScreenKeyboard)?.isKeyboardShown() == true) {
                (driver as HidesKeyboard).hideKeyboard()
            }
        } catch (ignored: RuntimeException) {
            // no keyboard to dismiss
        }
    }

    private fun scrollDown() {
{% if ios %}
        driver.executeScript("mobile: scroll", mapOf("direction" to "down"))
{% else %}
        val size = driver.manage().window().size
        driver.executeScript(
            "mobile: scrollGesture",
            mapOf(
                "left" to (size.width * 0.1).toInt(),
                "top" to (size.height * 0.2).toInt(),
                "width" to (size.width * 0.8).toInt(),
                "height" to (size.height * 0.6).toInt(),
                "direction" to "down",
                "percent" to 0.8,
            ),
        )
{% endif %}
    }

    private companion object {
        val TIMEOUT: Duration = Duration.ofSeconds(10)
        val POLL: Duration = Duration.ofMillis(250)
        val SETTLE_TIMEOUT: Duration = Duration.ofSeconds(5)
        const val SCROLL_TRIES = 4
        val BUSY: By = AppiumBy.xpath({{ busy | kotlin_str }})
        const val APP = {{ app_package | kotlin_str }}
    }
}
