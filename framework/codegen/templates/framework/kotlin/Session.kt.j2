package mobiscout.support

import io.appium.java_client.AppiumDriver
import io.appium.java_client.InteractsWithApps
import io.appium.java_client.android.AndroidDriver
import io.appium.java_client.android.options.UiAutomator2Options
import io.appium.java_client.ios.IOSDriver
import io.appium.java_client.ios.options.XCUITestOptions
import java.net.URI

/**
 * The Appium session every test shares, on the platform this run drives ([Platform]).
 *
 * Fast by design: ONE session serves the whole run (opening a session costs 5-10 s), opened on
 * first use and closed when the test JVM exits; the app is cold-restarted before each
 * test (~1-2 s), so every test still begins clean. Run against another Appium server or a cloud
 * grid with `MOBISCOUT_APPIUM_SERVER`.
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
object Session {

    val APP: String = Platform.APP

    private val server = System.getenv("MOBISCOUT_APPIUM_SERVER") ?: "http://localhost:4723"

    private var current: AppiumDriver? = null

    init {
        // Close whatever session is open when the test JVM exits.
        Runtime.getRuntime().addShutdownHook(Thread { close() })
    }

    /** The shared session, opened on first use — and again after [ensureAlive] dropped a dead one. */
    val driver: AppiumDriver
        @Synchronized get() = current ?: open().also { current = it }

    /** App management on the shared session (terminate / activate / state). */
    val apps: InteractsWithApps
        get() = driver as InteractsWithApps

    /**
     * Drop the session if it no longer answers (Appium or the driver crashed), so the next
     * [driver] opens a new one: one crash costs one test, not the rest of the run.
     */
    @Synchronized
    fun ensureAlive() {
        val session = current ?: return
        try {
            (session as InteractsWithApps).queryAppState(APP)
        } catch (e: RuntimeException) {
            close()
        }
    }

    @Synchronized
    private fun close() {
        try {
            current?.quit()
        } catch (ignored: RuntimeException) {
            // already gone
        }
        current = null
    }

    private fun open(): AppiumDriver {
        val url = URI.create(server).toURL()
        if (Platform.IOS) {
            val options = XCUITestOptions()
                .setBundleId(APP)
                .setNoReset(true) // keep app data; each test restarts the app itself
{% if apps["ios"].launch_args %}
            options.setCapability("appium:processArguments", mapOf("args" to listOf({{ apps["ios"].launch_args | kotlin_str_list }})))
{% endif %}
            return IOSDriver(url, options).apply {
                // Don't wait for the UI to go idle after every command: a live app rarely does.
                setSetting("waitForIdleTimeout", 0)
                setSetting("animationCoolOffTimeout", 0)
            }
        }
        val options = UiAutomator2Options()
            .setAppPackage(APP)
{% if apps["android"].app_activity %}
            .setAppActivity({{ apps["android"].app_activity | kotlin_str }})
{% endif %}
            .setNoReset(true) // keep app data; each test restarts the app itself
        options.setCapability("appium:disableWindowAnimation", true) // animations only cost time
        return AndroidDriver(url, options).apply {
            // Don't wait for the UI to go idle after every command: a live app rarely does, and
            // UiAutomator2 would otherwise stall up to 10 s per command.
            setSetting("waitForIdleTimeout", 100)
        }
    }
}
