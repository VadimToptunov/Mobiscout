package mobiscout.pages

import io.appium.java_client.AppiumBy
import io.appium.java_client.AppiumDriver
{% if multi %}
import mobiscout.support.Platform
{% endif %}

/**
 * The {{ page.title | kdoc }} screen.
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
class {{ page.class_name }}(driver: AppiumDriver) : BasePage(driver) {

    override val screen = {{ page.title | kotlin_str }}

{% if multi %}
    override val identity: String? = mapOf(
{% for p, key in page.identities.items() if key %}
        {{ p | kotlin_str }} to {{ key | kotlin_str }},
{% endfor %}
    )[Platform.CURRENT]

    // Element -> platform -> ranked locators; this run's platform picks its column.
    override val locators = mapOf(
{% for e in page.elements %}
        {{ e.key | kotlin_str }} to mapOf(
{% for p, sel in e.selectors.items() %}
            {{ p | kotlin_str }} to listOf({{ sel | by_items(p) }}),
{% endfor %}
        ),
{% endfor %}
    ).mapValues { (_, byPlatform) -> byPlatform[Platform.CURRENT].orEmpty() }
{% else %}
    override val identity: String? = {{ page.identity | kotlin_opt_str }}

    override val locators = mapOf(
{% for e in page.elements %}
        {{ e.key | kotlin_str }} to listOf({{ e.selector | by_items(platform) }}),
{% endfor %}
    )
{% endif %}
{% for m in methods %}

{% if m.kind == "tap" %}
{% if m.target %}
    /** Tap {{ m.label | kdoc }} — opens the {{ m.target_title | kdoc }} screen. */
    fun tap{{ m.pascal }}(): {{ m.target }} {
        tap({{ m.key | kotlin_str }})
        return {{ m.target }}(driver)
    }
{% else %}
    /** Tap {{ m.label | kdoc }}. */
    fun tap{{ m.pascal }}(): {{ page.class_name }} = apply { tap({{ m.key | kotlin_str }}) }
{% endif %}
{% elif m.kind == "enter" %}
    /** Type [value] into {{ m.label | kdoc }}. */
    fun enter{{ m.pascal }}(value: String): {{ page.class_name }} = apply { type({{ m.key | kotlin_str }}, value) }
{% elif m.kind == "has" %}
    /** Whether {{ m.label | kdoc }} is shown. */
    fun has{{ m.pascal }}(): Boolean = isVisible({{ m.key | kotlin_str }})
{% elif m.kind == "lacks" %}
    /** Whether {{ m.label | kdoc }} is absent. */
    fun lacks{{ m.pascal }}(): Boolean = isGone({{ m.key | kotlin_str }})
{% elif m.kind == "text" %}
    /** The text {{ m.label | kdoc }} shows. */
    fun {{ m.camel }}Text(): String = textOf({{ m.key | kotlin_str }})
{% elif m.kind == "enabled" %}
    /** Whether {{ m.label | kdoc }} can be used. */
    fun {{ m.camel }}IsEnabled(): Boolean = isEnabled({{ m.key | kotlin_str }})
{% endif %}
{% endfor %}
}
