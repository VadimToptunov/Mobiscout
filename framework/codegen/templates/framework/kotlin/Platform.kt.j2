package mobiscout.support

import java.util.Locale

/**
 * Which platform this run drives — one suite serves both. Set `MOBISCOUT_PLATFORM` to `android`
 * or `ios` (default `{{ platforms[0] }}`).
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
object Platform {

    /** "android" or "ios". */
    val CURRENT: String = (System.getenv("MOBISCOUT_PLATFORM") ?: {{ platforms[0] | kotlin_str }}).lowercase(Locale.ROOT)

    /** Whether this run drives iOS. */
    val IOS: Boolean = CURRENT == "ios"

    /** The app under test on this platform. */
    val APP: String = if (IOS) {{ apps["ios"].app_id | kotlin_str }} else {{ apps["android"].app_id | kotlin_str }}
}
