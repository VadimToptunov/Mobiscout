package mobiscout.support

{% if ios %}
import io.appium.java_client.ios.IOSDriver
{% else %}
import io.appium.java_client.android.AndroidDriver
{% endif %}
import org.junit.jupiter.api.BeforeEach

/**
 * Every test starts from a cold restart of the app on the shared [Session].
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
abstract class BaseTest {

    protected val driver: {{ "IOSDriver" if ios else "AndroidDriver" }}
        get() = Session.driver

    @BeforeEach
    fun restartApp() {
        try {
            driver.terminateApp(Session.APP)
        } catch (ignored: RuntimeException) {
            // the app was not running
        }
        driver.activateApp(Session.APP)
    }
}
