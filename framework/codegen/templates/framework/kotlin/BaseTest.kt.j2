package mobiscout.support

import io.appium.java_client.AppiumDriver
import org.junit.jupiter.api.Assumptions.assumeTrue
import org.junit.jupiter.api.BeforeEach

/**
 * Every test starts from a cold restart of the app on the shared [Session], on the platform
 * this run drives ([Platform]).
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
abstract class BaseTest {

    protected val driver: AppiumDriver
        get() = Session.driver

    @BeforeEach
    fun restartApp() {
        Session.ensureAlive() // a crashed session costs one test, not the rest of the run
        try {
            Session.apps.terminateApp(Session.APP)
        } catch (ignored: RuntimeException) {
            // the app was not running
        }
        Session.apps.activateApp(Session.APP)
    }

    /** Skip the calling test unless this run drives [platform] (Back is Android-only). */
    protected fun onlyOn(platform: String) =
        assumeTrue(platform == Platform.CURRENT) { "$platform only; this run is ${Platform.CURRENT}" }
}
