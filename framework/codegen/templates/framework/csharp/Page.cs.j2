using OpenQA.Selenium;
using OpenQA.Selenium.Appium;
{% if multi %}
using MobileTests.Support;
{% elif platform == "ios" %}
using OpenQA.Selenium.Appium.iOS;
{% else %}
using OpenQA.Selenium.Appium.Android;
{% endif %}

namespace MobileTests.Pages;

/// <summary>The {{ page.title | xmldoc }} screen.</summary>
/// <remarks>Auto-generated by Mobiscout. Regenerate rather than hand-edit.</remarks>
public sealed class {{ page.class_name }}({{ driver }} driver) : BasePage(driver)
{
{% if multi %}
    // Element -> platform -> ranked locators; this run's platform picks its column.
    private static readonly Dictionary<string, Dictionary<string, By[]>> ByPlatform = new()
    {
{% for e in page.elements %}
        [{{ e.key | cs_str }}] = new()
        {
{% for p, sel in e.selectors.items() %}
            [{{ p | cs_str }}] = [{{ sel | by_items(p) }}],
{% endfor %}
        },
{% endfor %}
    };

    private static readonly IReadOnlyDictionary<string, By[]> Elements =
        ByPlatform.ToDictionary(e => e.Key, e => e.Value.GetValueOrDefault(TargetPlatform.Current, []));

    private static readonly Dictionary<string, string> Identities = new()
    {
{% for p, key in page.identities.items() if key %}
        [{{ p | cs_str }}] = {{ key | cs_str }},
{% endfor %}
    };
{% else %}
    private static readonly IReadOnlyDictionary<string, By[]> Elements = new Dictionary<string, By[]>
    {
{% for e in page.elements %}
        [{{ e.key | cs_str }}] = [{{ e.selector | by_items(platform) }}],
{% endfor %}
    };
{% endif %}

    protected override string Screen => {{ page.title | cs_str }};

{% if multi %}
    protected override string? Identity => Identities.GetValueOrDefault(TargetPlatform.Current);
{% else %}
    protected override string? Identity => {{ page.identity | cs_opt_str }};
{% endif %}

    protected override IReadOnlyDictionary<string, By[]> Locators => Elements;
{% for m in methods %}

{% if m.kind == "tap" %}
{% if m.target %}
    /// <summary>Tap {{ m.label | xmldoc }} — opens the {{ m.target_title | xmldoc }} screen.</summary>
    public {{ m.target }} Tap{{ m.pascal }}()
    {
        Tap({{ m.key | cs_str }});
        return new {{ m.target }}(Driver);
    }
{% else %}
    /// <summary>Tap {{ m.label | xmldoc }}.</summary>
    public {{ page.class_name }} Tap{{ m.pascal }}()
    {
        Tap({{ m.key | cs_str }});
        return this;
    }
{% endif %}
{% elif m.kind == "enter" %}
    /// <summary>Type <paramref name="value"/> into {{ m.label | xmldoc }}.</summary>
    public {{ page.class_name }} Enter{{ m.pascal }}(string value)
    {
        Type({{ m.key | cs_str }}, value);
        return this;
    }
{% elif m.kind == "has" %}
    /// <summary>Whether {{ m.label | xmldoc }} is shown.</summary>
    public bool Has{{ m.pascal }}() => IsVisible({{ m.key | cs_str }});
{% elif m.kind == "lacks" %}
    /// <summary>Whether {{ m.label | xmldoc }} is absent.</summary>
    public bool Lacks{{ m.pascal }}() => IsGone({{ m.key | cs_str }});
{% elif m.kind == "text" %}
    /// <summary>The text {{ m.label | xmldoc }} shows.</summary>
    public string {{ m.pascal }}Text() => TextOf({{ m.key | cs_str }});
{% elif m.kind == "enabled" %}
    /// <summary>Whether {{ m.label | xmldoc }} can be used.</summary>
    public bool {{ m.pascal }}IsEnabled() => IsEnabledElement({{ m.key | cs_str }});
{% endif %}
{% endfor %}
}
