namespace MobileTests.Support;

/// <summary>Which platform this run drives — one suite serves both.</summary>
/// <remarks>
/// Set <c>MOBISCOUT_PLATFORM</c> to <c>android</c> or <c>ios</c> (default <c>{{ platforms[0] }}</c>).
/// Auto-generated by Mobiscout. Regenerate rather than hand-edit.
/// </remarks>
public static class TargetPlatform
{
    /// <summary>"android" or "ios".</summary>
    public static readonly string Current =
        (Environment.GetEnvironmentVariable("MOBISCOUT_PLATFORM") ?? {{ platforms[0] | cs_str }}).ToLowerInvariant();

    /// <summary>Whether this run drives iOS.</summary>
    public static readonly bool IsIos = Current == "ios";

    /// <summary>The app under test on this platform.</summary>
    public static readonly string App = IsIos ? {{ apps["ios"].app_id | cs_str }} : {{ apps["android"].app_id | cs_str }};
}
