using NUnit.Framework;
using OpenQA.Selenium.Appium;

namespace MobileTests.Support;

/// <summary>Every test starts from a cold restart of the app on the shared <see cref="Session"/>.</summary>
/// <remarks>Auto-generated by Mobiscout. Regenerate rather than hand-edit.</remarks>
public abstract class BaseTest
{
    protected static AppiumDriver Driver => Session.Driver;

    [SetUp]
    public void RestartApp() => Session.RestartApp();

    /// <summary>Skip the calling test unless this run drives <paramref name="platform"/> (Back is Android-only).</summary>
    protected static void OnlyOn(string platform)
    {
        if (platform != TargetPlatform.Current)
        {
            Assert.Ignore($"{platform} only; this run is {TargetPlatform.Current}");
        }
    }
}
