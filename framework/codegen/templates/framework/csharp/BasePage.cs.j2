using OpenQA.Selenium;
using OpenQA.Selenium.Appium;
{% if multi %}
using MobileTests.Support;
using OpenQA.Selenium.Appium.Android;
using OpenQA.Selenium.Appium.iOS;
{% elif ios %}
using OpenQA.Selenium.Appium.iOS;
{% else %}
using OpenQA.Selenium.Appium.Android;
{% endif %}
using OpenQA.Selenium.Appium.Enums;
using OpenQA.Selenium.Support.UI;

namespace MobileTests.Pages;

/// <summary>
/// Shared behaviour for every page object, written once.
/// </summary>
/// <remarks>
/// Locating is ranked and self-healing (primary locator first, then fallbacks), waits on a
/// condition instead of sleeping (returns the moment the element is there) and scrolls to reach
/// a below-the-fold control. Acting settles the screen afterwards — a loading spinner gone, the
/// soft keyboard dismissed — so the next step never races a transition.
/// Auto-generated by Mobiscout. Regenerate rather than hand-edit.
/// </remarks>
public abstract class BasePage({{ driver }} driver)
{
    private static readonly TimeSpan Timeout = TimeSpan.FromSeconds(10);
    private static readonly TimeSpan Poll = TimeSpan.FromMilliseconds(250);
    private static readonly TimeSpan SettleTimeout = TimeSpan.FromSeconds(5);
    private const int ScrollTries = 4;
{% if multi %}
    private static readonly string App = TargetPlatform.App;
    private static readonly By Busy =
        By.XPath(TargetPlatform.IsIos ? "//XCUIElementTypeActivityIndicator" : "//android.widget.ProgressBar");
{% else %}
    private const string App = {{ app_package | cs_str }};
    private static readonly By Busy = By.XPath({{ busy | cs_str }});
{% endif %}

    protected {{ driver }} Driver { get; } = driver;

    /// <summary>The screen's title, for failure messages.</summary>
    protected abstract string Screen { get; }

    /// <summary>The element distinctive to this screen, or <c>null</c> when none is.</summary>
    protected abstract string? Identity { get; }

    /// <summary>Ranked locators (primary first, then self-healing fallbacks) per element.</summary>
    protected abstract IReadOnlyDictionary<string, By[]> Locators { get; }

    /// <summary>Whether this screen is the one on display, proven by an element only it has.</summary>
    public bool IsDisplayed() =>
        Identity is { } identity
            ? IsVisible(identity)
            : throw new InvalidOperationException($"{GetType().Name} has no element distinctive enough to identify it");

    /// <summary>Whether the app under test is still up in the foreground — it did not crash.</summary>
{% if multi %}
    public bool IsAppRunning() =>
        Driver switch
        {
            IOSDriver ios => ios.GetAppState(App),
            AndroidDriver android => android.GetAppState(App),
            _ => throw new InvalidOperationException($"not an Android or iOS session: {Driver.GetType().Name}"),
        } == AppState.RunningInForeground;
{% else %}
    public bool IsAppRunning() => Driver.GetAppState(App) == AppState.RunningInForeground;
{% endif %}

    /// <summary>Press the system Back.</summary>
    public void GoBack()
    {
        Driver.Navigate().Back();
        Settle();
    }

    /// <summary>The element, waiting for it to appear and scrolling to reach it if needed.</summary>
    protected IWebElement Find(string name)
    {
        try
        {
            return Wait(Timeout).Until(_ => Locate(name))!;
        }
        catch (WebDriverTimeoutException)
        {
            // not on screen yet — it may be below the fold
        }
        for (var i = 0; i < ScrollTries; i++)
        {
            ScrollDown();
            if (Locate(name) is { } found)
            {
                return found;
            }
        }
        throw new NoSuchElementException($"'{name}' not found on the {Screen} screen within {Timeout.TotalSeconds}s");
    }

    protected bool IsVisible(string name)
    {
        try
        {
            return Find(name).Displayed;
        }
        catch (NoSuchElementException)
        {
            return false;
        }
    }

    /// <summary>Whether the element is absent — returns the moment it is, not after the full timeout.</summary>
    protected bool IsGone(string name)
    {
        try
        {
            return Wait(Timeout).Until(_ => Locate(name) is null);
        }
        catch (WebDriverTimeoutException)
        {
            return false;
        }
    }

    protected string TextOf(string name) => Find(name).Text;

    protected bool IsEnabledElement(string name) => Find(name).Enabled;

    protected void Tap(string name)
    {
        Find(name).Click();
        Settle();
    }

    protected void Type(string name, string value)
    {
        var field = Find(name);
        field.Clear(); // replace, don't append to whatever the field held
        field.SendKeys(value);
        Settle();
    }

    private IWebElement? Locate(string name) =>
        Locators[name].Select(by => Driver.FindElements(by).FirstOrDefault()).FirstOrDefault(e => e is not null);

    private WebDriverWait Wait(TimeSpan timeout) => new(Driver, timeout) { PollingInterval = Poll };

    private void Settle()
    {
        try
        {
            Wait(SettleTimeout).Until(d => d.FindElements(Busy).Count == 0);
        }
        catch (WebDriverTimeoutException)
        {
            // a stuck spinner is tolerated, not failed
        }
        try
        {
            if (Driver.ExecuteScript("mobile: isKeyboardShown") is true)
            {
                Driver.ExecuteScript("mobile: hideKeyboard");
            }
        }
        catch (WebDriverException)
        {
            // no keyboard to dismiss
        }
    }

    private void ScrollDown()
    {
{% if multi %}
        if (TargetPlatform.IsIos)
        {
            Driver.ExecuteScript("mobile: scroll", new Dictionary<string, object> { ["direction"] = "down" });
            return;
        }
{% endif %}
{% if ios and not multi %}
        Driver.ExecuteScript("mobile: scroll", new Dictionary<string, object> { ["direction"] = "down" });
{% else %}
        var size = Driver.Manage().Window.Size;
        Driver.ExecuteScript(
            "mobile: scrollGesture",
            new Dictionary<string, object>
            {
                ["left"] = (int)(size.Width * 0.1),
                ["top"] = (int)(size.Height * 0.2),
                ["width"] = (int)(size.Width * 0.8),
                ["height"] = (int)(size.Height * 0.6),
                ["direction"] = "down",
                ["percent"] = 0.8,
            });
{% endif %}
    }
}
