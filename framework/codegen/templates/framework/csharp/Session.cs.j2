using OpenQA.Selenium;
using OpenQA.Selenium.Appium;
{% if ios %}
using OpenQA.Selenium.Appium.iOS;
{% else %}
using OpenQA.Selenium.Appium.Android;
{% endif %}
using OpenQA.Selenium.Appium.Enums;

namespace MobileTests.Support;

/// <summary>The Appium session every test shares, reopened if it died.</summary>
/// <remarks>
/// Fast by design: ONE session serves the whole run (opening a session costs 5-10 s) and the
/// app is cold-restarted before each test (~1-2 s), so every test still begins clean. An Appium
/// server or driver that crashes costs one test, not the rest of the run: the session is checked
/// before each test and reopened if it is gone. Run against another Appium server or a cloud grid
/// with <c>MOBISCOUT_APPIUM_SERVER</c>.
/// Auto-generated by Mobiscout. Regenerate rather than hand-edit.
/// </remarks>
public static class Session
{
    public const string App = {{ app_package | cs_str }};

    private static readonly Uri Server =
        new(Environment.GetEnvironmentVariable("MOBISCOUT_APPIUM_SERVER") ?? "http://localhost:4723");

    private static readonly Lock Gate = new();
    private static {{ driver }}? current;

    /// <summary>The shared session, opened on first use — and again after a dead one was dropped.</summary>
    public static {{ driver }} Driver
    {
        get
        {
            lock (Gate)
            {
                return current ??= Open();
            }
        }
    }

    /// <summary>A live session with the app cold-restarted, so the test begins clean.</summary>
    public static void RestartApp()
    {
        EnsureAlive();
        try
        {
            Driver.TerminateApp(App);
        }
        catch (WebDriverException)
        {
            // the app was not running
        }
        Driver.ActivateApp(App);
    }

    /// <summary>Close the session, if one is open.</summary>
    public static void Close()
    {
        lock (Gate)
        {
            try
            {
                current?.Quit();
            }
            catch (WebDriverException)
            {
                // already gone
            }
            current = null;
        }
    }

    private static void EnsureAlive()
    {
        lock (Gate)
        {
            if (current is null)
            {
                return;
            }
            try
            {
                current.GetAppState(App);
            }
            catch (WebDriverException)
            {
                Close();
            }
        }
    }

    private static {{ driver }} Open()
    {
        var options = new AppiumOptions
        {
{% if ios %}
            PlatformName = "iOS",
            AutomationName = AutomationName.iOSXcuiTest,
{% else %}
            PlatformName = "Android",
            AutomationName = AutomationName.AndroidUIAutomator2,
{% endif %}
        };
{% if ios %}
        options.AddAdditionalAppiumOption("bundleId", App);
{% if launch_args %}
        options.AddAdditionalAppiumOption(
            "processArguments", new Dictionary<string, object> { ["args"] = new[] { {{ launch_args | cs_str_list }} } });
{% endif %}
{% else %}
        options.AddAdditionalAppiumOption("appPackage", App);
{% if app_activity %}
        options.AddAdditionalAppiumOption("appActivity", {{ app_activity | cs_str }});
{% endif %}
        options.AddAdditionalAppiumOption("disableWindowAnimation", true); // animations only cost time
{% endif %}
        options.AddAdditionalAppiumOption("noReset", true); // keep app data; each test restarts the app itself
        var session = new {{ driver }}(Server, options);
{% if ios %}
        // Don't wait for the UI to go idle after every command: a live app rarely does.
        session.SetSetting("waitForIdleTimeout", 0);
        session.SetSetting("animationCoolOffTimeout", 0);
{% else %}
        // Don't wait for the UI to go idle after every command: a live app rarely does, and
        // UiAutomator2 would otherwise stall up to 10 s per command.
        session.SetSetting("waitForIdleTimeout", 100);
{% endif %}
        return session;
    }
}
