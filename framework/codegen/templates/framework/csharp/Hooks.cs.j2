using NUnit.Framework;
using Reqnroll;

namespace MobileTests.Support;

/// <summary>
/// Every scenario starts from a cold restart of the app on the shared <see cref="Session"/>; one
/// tagged for a single platform (<c>@android</c> / <c>@ios</c>) is skipped on the other.
/// </summary>
/// <remarks>Auto-generated by Mobiscout. Regenerate rather than hand-edit.</remarks>
[Binding]
public sealed class Hooks
{
    [BeforeScenario(Order = 0)]
    public void OnlyOnItsPlatform(ScenarioContext scenario)
    {
        var tags = scenario.ScenarioInfo.Tags;
        if ((tags.Contains("android") || tags.Contains("ios")) && !tags.Contains(TargetPlatform.Current))
        {
            Assert.Ignore($"not for {TargetPlatform.Current}: {string.Join(", ", tags)}");
        }
    }

    [BeforeScenario(Order = 1)]
    public void RestartApp() => Session.RestartApp();

    [AfterTestRun]
    public static void CloseSession() => Session.Close();
}
