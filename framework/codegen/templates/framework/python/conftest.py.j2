"""
Shared pytest fixtures.

Fast by design: ONE Appium session serves the whole run (opening a session costs 5-10 s),
and each test starts from a cold restart of the app (~1-2 s) — every test still begins
clean, without paying for a new session each time.

Run against another Appium server or a cloud grid with MOBISCOUT_APPIUM_SERVER.

Auto-generated by Mobiscout. Regenerate rather than hand-edit.
"""

import os

import pytest
from appium import webdriver
{% if platform == "ios" %}
from appium.options.ios import XCUITestOptions
{% else %}
from appium.options.android import UiAutomator2Options
{% endif %}

APP = {{ app_package | py_str }}
SERVER = os.environ.get("MOBISCOUT_APPIUM_SERVER", "http://localhost:4723")


def _options():
{% if platform == "ios" %}
    options = XCUITestOptions()
    options.platform_name = "iOS"
    options.automation_name = "XCUITest"
    options.bundle_id = APP
{% if launch_args %}
    options.set_capability("appium:processArguments", {"args": {{ launch_args | py_list }}})
{% endif %}
{% else %}
    options = UiAutomator2Options()
    options.platform_name = "Android"
    options.automation_name = "UiAutomator2"
    options.app_package = APP
{% if app_activity %}
    options.app_activity = {{ app_activity | py_str }}
{% endif %}
    # Window animations only cost time in a test run.
    options.set_capability("appium:disableWindowAnimation", True)
{% endif %}
    # Keep the app's data between tests; each test restarts the app itself (below).
    options.set_capability("appium:noReset", True)
    return options


@pytest.fixture(scope="session")
def _appium_session():
    session = webdriver.Remote(SERVER, options=_options())
    try:
        # Don't wait for the UI to go idle after every command: a live app rarely does,
        # and the driver would otherwise stall up to 10 s per command.
{% if platform == "ios" %}
        session.update_settings({"waitForIdleTimeout": 0, "animationCoolOffTimeout": 0})
{% else %}
        session.update_settings({"waitForIdleTimeout": 100})
{% endif %}
    except Exception:
        pass
    yield session
    session.quit()


@pytest.fixture()
def driver(_appium_session):
    """The shared session, with the app freshly restarted for this test."""
    try:
        _appium_session.terminate_app(APP)
    except Exception:
        pass
    _appium_session.activate_app(APP)
    return _appium_session
