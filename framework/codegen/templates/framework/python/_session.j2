{# The Appium session setup every Python suite shares (pytest fixtures, Behave hooks). #}
{% macro imports(platform) %}
from appium import webdriver
{% if platform == "ios" %}
from appium.options.ios import XCUITestOptions
{% else %}
from appium.options.android import UiAutomator2Options
{% endif %}
{% endmacro %}

{% macro options(platform, app_package, app_activity, launch_args) %}
APP = {{ app_package | py_str }}
SERVER = os.environ.get("MOBISCOUT_APPIUM_SERVER", "http://localhost:4723")


def _options():
{% if platform == "ios" %}
    options = XCUITestOptions()
    options.platform_name = "iOS"
    options.automation_name = "XCUITest"
    options.bundle_id = APP
{% if launch_args %}
    options.set_capability("appium:processArguments", {"args": {{ launch_args | py_list }}})
{% endif %}
{% else %}
    options = UiAutomator2Options()
    options.platform_name = "Android"
    options.automation_name = "UiAutomator2"
    options.app_package = APP
{% if app_activity %}
    options.app_activity = {{ app_activity | py_str }}
{% endif %}
    # Window animations only cost time in a test run.
    options.set_capability("appium:disableWindowAnimation", True)
{% endif %}
    # Keep the app's data between tests; each test restarts the app itself (below).
    options.set_capability("appium:noReset", True)
    return options
{% endmacro %}

{% macro idle_settings(platform) %}{% if platform == "multi" %}{"android": {"waitForIdleTimeout": 100}, "ios": {"waitForIdleTimeout": 0, "animationCoolOffTimeout": 0}}[PLATFORM]{% elif platform == "ios" %}{"waitForIdleTimeout": 0, "animationCoolOffTimeout": 0}{% else %}{"waitForIdleTimeout": 100}{% endif %}{% endmacro %}

{% macro session_class(platform) %}
class Session:
    """The Appium session the whole run shares, reopened if it died.

    Opening a session costs 5-10 s, so one serves every test. But an Appium server or driver
    that crashes must cost ONE test, not every test after it: before each test the session
    is checked with one cheap call and reopened if it is gone.
    """

    def __init__(self):
        self._driver = None

    def restart_app(self):
        """The live session with the app cold-restarted, so the test begins clean."""
        driver = self._live()
        try:
            driver.terminate_app(APP)
        except Exception:
            pass  # the app was not running
        driver.activate_app(APP)
        return driver

    def close(self):
        """End the session, if one is open."""
        if self._driver is not None:
            try:
                self._driver.quit()
            except Exception:
                pass  # already gone
            self._driver = None

    def _live(self):
        if self._driver is not None and not self._alive():
            self.close()
        if self._driver is None:
            self._driver = webdriver.Remote(SERVER, options=_options())
            try:
                # Don't wait for the UI to go idle after every command: a live app rarely
                # does, and the driver would otherwise stall up to 10 s per command.
                self._driver.update_settings({{ idle_settings(platform) }})
            except Exception:
                pass
        return self._driver

    def _alive(self):
        try:
            self._driver.query_app_state(APP)
            return True
        except Exception:
            return False
{% endmacro %}

{# --- Cross-platform kit: the platform is chosen at run time (MOBISCOUT_PLATFORM). --- #}
{% macro imports_multi() %}
from appium import webdriver
from appium.options.android import UiAutomator2Options
from appium.options.ios import XCUITestOptions

from pages.base_page import APPS, PLATFORM
{% endmacro %}

{% macro options_multi(apps) %}
APP = APPS[PLATFORM]
SERVER = os.environ.get("MOBISCOUT_APPIUM_SERVER", "http://localhost:4723")


def _options():
    if PLATFORM == "ios":
        options = XCUITestOptions()
        options.platform_name = "iOS"
        options.automation_name = "XCUITest"
        options.bundle_id = APP
{% if apps["ios"].launch_args %}
        options.set_capability("appium:processArguments", {"args": {{ apps["ios"].launch_args | py_list }}})
{% endif %}
    else:
        options = UiAutomator2Options()
        options.platform_name = "Android"
        options.automation_name = "UiAutomator2"
        options.app_package = APP
{% if apps["android"].app_activity %}
        options.app_activity = {{ apps["android"].app_activity | py_str }}
{% endif %}
        # Window animations only cost time in a test run.
        options.set_capability("appium:disableWindowAnimation", True)
    # Keep the app's data between tests; each test restarts the app itself (below).
    options.set_capability("appium:noReset", True)
    return options
{% endmacro %}

