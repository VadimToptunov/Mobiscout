"""
BasePage — the plumbing every page object shares, written once.

Locating is ranked and self-healing (primary locator first, then fallbacks), waits on a
condition instead of sleeping (returns the moment the element is there), and scrolls to
reach a below-the-fold control. Acting settles the screen afterwards — a loading spinner
gone, the soft keyboard dismissed — so the next step never races a transition.

Auto-generated by Mobiscout. Regenerate rather than hand-edit.
"""

{% if multi %}
import os

{% endif %}
from appium.webdriver.common.appiumby import AppiumBy
from selenium.common.exceptions import NoSuchElementException, TimeoutException
from selenium.webdriver.support.ui import WebDriverWait
{% if multi %}

# One suite, both platforms: which one this run drives ("android" or "ios").
PLATFORM = os.environ.get("MOBISCOUT_PLATFORM", {{ platforms[0] | py_str }}).lower()
# The app under test on each platform.
APPS = {
{% for p, app in apps.items() %}
    {{ p | py_str }}: {{ app.app_id | py_str }},
{% endfor %}
}
{% endif %}


class BasePage:
    """Shared behaviour for every page object."""

    TIMEOUT = 10  # seconds an element may take to appear
    POLL = 0.25  # how often a wait re-checks — condition-based, never a fixed sleep
    SCROLL_TRIES = 4  # scrolls tried for a below-the-fold element before giving up
    SETTLE_TIMEOUT = 5  # longest a loading spinner is waited out after an action
{% if multi %}
    BUSY_XPATH = {"android": "//android.widget.ProgressBar", "ios": "//XCUIElementTypeActivityIndicator"}[PLATFORM]
    APP = APPS[PLATFORM]  # the app under test
{% else %}
    BUSY_XPATH = {{ busy_xpath | py_str }}
    APP = {{ app_package | py_str }}  # the app under test
{% endif %}
    _FOREGROUND = 4  # Appium's app state: running in the foreground

    SCREEN = ""  # set by each page: its screen's title
{% if multi %}
    IDENTITY = {}  # set by each page: platform -> the element distinctive to it
    LOCATORS = {}  # set by each page: element name -> platform -> ranked [(by, value), ...]
{% else %}
    IDENTITY = None  # set by each page: the element distinctive to it
    LOCATORS = {}  # set by each page: element name -> ranked [(by, value), ...]
{% endif %}

    def __init__(self, driver):
        self.driver = driver

    # --- identity -------------------------------------------------------------------
    def is_displayed(self):
        """Whether this screen is the one on display, proven by an element only it has."""
{% if multi %}
        identity = self.IDENTITY.get(PLATFORM)
        if identity is None:
            raise NotImplementedError(f"{type(self).__name__} has no element distinctive enough to identify it on {PLATFORM}")
        return self._is_visible(identity)
{% else %}
        if self.IDENTITY is None:
            raise NotImplementedError(f"{type(self).__name__} has no element distinctive enough to identify it")
        return self._is_visible(self.IDENTITY)
{% endif %}

    def is_app_running(self):
        """Whether the app under test is still up in the foreground — it did not crash."""
        return self.driver.query_app_state(self.APP) == self._FOREGROUND

    # --- locating -------------------------------------------------------------------
    def _locate(self, name):
        """One pass over the element's ranked locators, no waiting."""
{% if multi %}
        for by, value in self.LOCATORS[name].get(PLATFORM, []):
{% else %}
        for by, value in self.LOCATORS[name]:
{% endif %}
            try:
                return self.driver.find_element(by, value)
            except NoSuchElementException:
                continue
        return None

    def _find(self, name):
        """The element, waiting for it to appear and scrolling to reach it if needed."""
        try:
            return WebDriverWait(self.driver, self.TIMEOUT, poll_frequency=self.POLL).until(
                lambda _driver: self._locate(name) or False
            )
        except TimeoutException:
            pass
        for _ in range(self.SCROLL_TRIES):
            self._scroll_down()
            found = self._locate(name)
            if found is not None:
                return found
        raise NoSuchElementException(f"{name!r} not found on the {self.SCREEN} screen within {self.TIMEOUT}s")

    def _is_visible(self, name):
        try:
            return self._find(name).is_displayed()
        except NoSuchElementException:
            return False

    def _is_gone(self, name):
        """Whether the element is absent — returns the moment it is, rather than waiting
        out the whole timeout the way ``not has_x()`` would."""
        try:
            return WebDriverWait(self.driver, self.TIMEOUT, poll_frequency=self.POLL).until(
                lambda _driver: self._locate(name) is None
            )
        except TimeoutException:
            return False

    def _text(self, name):
        return self._find(name).text

    def _is_enabled(self, name):
        return self._find(name).is_enabled()

    # --- acting ---------------------------------------------------------------------
    def go_back(self):
        """Press the system Back."""
        self.driver.back()
        self._settle()

    def _tap(self, name):
        self._find(name).click()
        self._settle()

    def _type(self, name, value):
        element = self._find(name)
        element.clear()  # replace, don't append to whatever the field held
        element.send_keys(value)
        self._settle()

    def _settle(self):
        """After an action: wait out a loading spinner (instant when there is none) and
        dismiss the soft keyboard, which can cover or drop the next control."""
        try:
            WebDriverWait(self.driver, self.SETTLE_TIMEOUT, poll_frequency=self.POLL).until(
                lambda driver: not driver.find_elements(AppiumBy.XPATH, self.BUSY_XPATH)
            )
        except TimeoutException:
            pass
        try:
            if self.driver.is_keyboard_shown():
                self.driver.hide_keyboard()
        except Exception:
            pass

    def _scroll_down(self):
{% if multi %}
        if PLATFORM == "ios":
            self.driver.execute_script("mobile: scroll", {"direction": "down"})
            return
{% endif %}
{% if platform == "ios" and not multi %}
        self.driver.execute_script("mobile: scroll", {"direction": "down"})
{% else %}
        size = self.driver.get_window_size()
        self.driver.execute_script(
            "mobile: scrollGesture",
            {
                "left": int(size["width"] * 0.1),
                "top": int(size["height"] * 0.2),
                "width": int(size["width"] * 0.8),
                "height": int(size["height"] * 0.6),
                "direction": "down",
                "percent": 0.8,
            },
        )
{% endif %}
