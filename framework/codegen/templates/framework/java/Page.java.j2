{% if m.target %}
        return new {{ m.target }}(driver);
{% else %}
        return this;
{% endif %}
    }
{% elif m.kind == "enter" %}
    /** Type {@code value} into {{ m.label | javadoc }}. */
    public {{ page.class_name }} enter{{ m.pascal }}(String value) {
