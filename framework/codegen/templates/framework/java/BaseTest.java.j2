package mobiscout.support;

import io.appium.java_client.AppiumDriver;
import io.appium.java_client.InteractsWithApps;
import io.appium.java_client.android.AndroidDriver;
import io.appium.java_client.android.options.UiAutomator2Options;
import io.appium.java_client.ios.IOSDriver;
import io.appium.java_client.ios.options.XCUITestOptions;
import java.net.MalformedURLException;
import java.net.URI;
import java.net.URL;
{% if apps["ios"].launch_args %}
import java.util.List;
import java.util.Map;
{% endif %}
import org.testng.SkipException;
import org.testng.annotations.AfterSuite;
import org.testng.annotations.BeforeMethod;
import org.testng.annotations.BeforeSuite;

/**
 * Driver lifecycle for every test class — one suite for both platforms ({@link Platform}).
 *
 * <p>Fast by design: ONE Appium session serves the whole suite (opening a session costs 5-10 s)
 * and each test starts from a cold restart of the app (~1-2 s) — every test still begins clean,
 * without paying for a new session each time. Run against another Appium server or a cloud grid
 * with {@code MOBISCOUT_APPIUM_SERVER}.
 *
 * <p>Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
public abstract class BaseTest {

    protected static final String APP = Platform.APP;
    private static final String SERVER =
            System.getenv().getOrDefault("MOBISCOUT_APPIUM_SERVER", "http://localhost:4723");

    protected static AppiumDriver driver;

    @BeforeSuite(alwaysRun = true)
    public void startSession() throws MalformedURLException {
        URL server = URI.create(SERVER).toURL();
        if (Platform.IOS) {
            XCUITestOptions options = new XCUITestOptions()
                    .setBundleId(APP)
                    .setNoReset(true); // keep app data; each test restarts the app itself
{% if apps["ios"].launch_args %}
            options.setCapability("appium:processArguments", Map.of("args", List.of({{ apps["ios"].launch_args | java_str_list }})));
{% endif %}
            IOSDriver ios = new IOSDriver(server, options);
            // Don't wait for the UI to go idle after every command: a live app rarely does.
            ios.setSetting("waitForIdleTimeout", 0);
            ios.setSetting("animationCoolOffTimeout", 0);
            driver = ios;
        } else {
            UiAutomator2Options options = new UiAutomator2Options()
                    .setAppPackage(APP)
{% if apps["android"].app_activity %}
                    .setAppActivity({{ apps["android"].app_activity | java_str }})
{% endif %}
                    .setNoReset(true); // keep app data; each test restarts the app itself
            options.setCapability("appium:disableWindowAnimation", true); // animations only cost time
            AndroidDriver android = new AndroidDriver(server, options);
            // Don't wait for the UI to go idle after every command: a live app rarely does, and
            // UiAutomator2 would otherwise stall up to 10 s per command.
            android.setSetting("waitForIdleTimeout", 100);
            driver = android;
        }
    }

    @BeforeMethod(alwaysRun = true)
    public void restartApp() throws MalformedURLException {
        if (!alive()) {
            // Appium or the driver crashed: this test gets a new session instead of the whole
            // rest of the run failing on a dead one.
            endSession();
            startSession();
        }
        try {
            apps().terminateApp(APP);
        } catch (RuntimeException ignored) {
            // the app was not running
        }
        apps().activateApp(APP);
    }

    @AfterSuite(alwaysRun = true)
    public void endSession() {
        if (driver != null) {
            try {
                driver.quit();
            } catch (RuntimeException ignored) {
                // already gone
            }
            driver = null;
        }
    }

    /** Skip the calling test unless this run drives {@code platform} (Back is Android-only). */
    protected static void onlyOn(String platform) {
        if (!platform.equals(Platform.CURRENT)) {
            throw new SkipException(platform + " only; this run is " + Platform.CURRENT);
        }
    }

    private static InteractsWithApps apps() {
        return (InteractsWithApps) driver;
    }

    /** Whether the session still answers — one cheap call. */
    private static boolean alive() {
        try {
            apps().queryAppState(APP);
            return true;
        } catch (RuntimeException e) {
            return false;
        }
    }
}
