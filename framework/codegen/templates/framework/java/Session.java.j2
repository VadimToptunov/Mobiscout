package mobiscout.support;

{% if ios %}
import io.appium.java_client.ios.IOSDriver;
import io.appium.java_client.ios.options.XCUITestOptions;
{% else %}
import io.appium.java_client.android.AndroidDriver;
import io.appium.java_client.android.options.UiAutomator2Options;
{% endif %}
import java.net.MalformedURLException;
import java.net.URI;
{% if ios and launch_args %}
import java.util.List;
import java.util.Map;
{% endif %}

/**
 * The Appium session every scenario shares.
 *
 * <p>Fast by design: ONE session serves the whole run (opening a session costs 5-10 s), opened
 * on first use; {@link Hooks} cold-restarts the app before each scenario (~1-2 s), so every
 * scenario still begins clean. Run against another Appium server or a cloud grid with
 * {@code MOBISCOUT_APPIUM_SERVER}.
 *
 * <p>Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
public final class Session {

    public static final String APP = {{ app_package | java_str }};
    private static final String SERVER =
            System.getenv().getOrDefault("MOBISCOUT_APPIUM_SERVER", "http://localhost:4723");

    private static {{ "IOSDriver" if ios else "AndroidDriver" }} driver;

    private Session() {}

    /** The shared session, opened on first use. */
    public static synchronized {{ "IOSDriver" if ios else "AndroidDriver" }} driver() {
        if (driver == null) {
            driver = open();
        }
        return driver;
    }

    /** Close the session, if one was opened. */
    static synchronized void close() {
        if (driver != null) {
            driver.quit();
            driver = null;
        }
    }

    private static {{ "IOSDriver" if ios else "AndroidDriver" }} open() {
        try {
{% if ios %}
            XCUITestOptions options = new XCUITestOptions()
                    .setBundleId(APP)
                    .setNoReset(true); // keep app data; each scenario restarts the app itself
{% if launch_args %}
            options.setCapability("appium:processArguments", Map.of("args", List.of({{ launch_args | java_str_list }})));
{% endif %}
            IOSDriver session = new IOSDriver(URI.create(SERVER).toURL(), options);
            // Don't wait for the UI to go idle after every command: a live app rarely does.
            session.setSetting("waitForIdleTimeout", 0);
            session.setSetting("animationCoolOffTimeout", 0);
{% else %}
            UiAutomator2Options options = new UiAutomator2Options()
                    .setAppPackage(APP)
{% if app_activity %}
                    .setAppActivity({{ app_activity | java_str }})
{% endif %}
                    .setNoReset(true); // keep app data; each scenario restarts the app itself
            options.setCapability("appium:disableWindowAnimation", true); // animations only cost time
            AndroidDriver session = new AndroidDriver(URI.create(SERVER).toURL(), options);
            // Don't wait for the UI to go idle after every command: a live app rarely does, and
            // UiAutomator2 would otherwise stall up to 10 s per command.
            session.setSetting("waitForIdleTimeout", 100);
{% endif %}
            return session;
        } catch (MalformedURLException e) {
            throw new IllegalStateException("Bad MOBISCOUT_APPIUM_SERVER: " + SERVER, e);
        }
    }
}
