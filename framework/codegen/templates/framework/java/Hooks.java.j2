package mobiscout.support;

import io.cucumber.java.AfterAll;
import io.cucumber.java.Before;
import io.cucumber.java.Scenario;
import org.opentest4j.TestAbortedException;

/**
 * Every scenario starts from a cold restart of the app on the shared {@link Session}; one tagged
 * for a single platform ({@code @android} / {@code @ios}) is skipped on the other.
 *
 * <p>Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */
public class Hooks {

    @Before(order = 0)
    public void onlyOnItsPlatform(Scenario scenario) {
        boolean tagged = scenario.getSourceTagNames().stream().anyMatch(t -> t.equals("@android") || t.equals("@ios"));
        if (tagged && !scenario.getSourceTagNames().contains("@" + Platform.CURRENT)) {
            throw new TestAbortedException("not for " + Platform.CURRENT + ": " + scenario.getSourceTagNames());
        }
    }

    @Before(order = 1)
    public void restartApp() {
        Session.ensureAlive();
        try {
            Session.apps().terminateApp(Session.APP);
        } catch (RuntimeException ignored) {
            // the app was not running
        }
        Session.apps().activateApp(Session.APP);
    }

    @AfterAll
    public static void closeSession() {
        Session.close();
    }
}
