/**
 * BasePage — the plumbing every page object shares, written once.
 *
 * Locating is ranked and self-healing (primary selector first, then fallbacks), waits on a
 * condition instead of pausing (returns the moment the element is there) and scrolls to reach
 * a below-the-fold control. Acting settles the screen afterwards — a loading spinner gone, the
 * soft keyboard dismissed — so the next step never races a transition.
 *
 * Auto-generated by Mobiscout. Regenerate rather than hand-edit.
 */

const TIMEOUT = 10000; // ms an element may take to appear
const POLL = 250; // how often a wait re-checks — condition-based, never a fixed pause
const SCROLL_TRIES = 4; // scrolls tried for a below-the-fold element before giving up
const SETTLE_TIMEOUT = 5000; // longest a loading spinner is waited out after an action
const BUSY = {{ busy | js_str }};
const APP = {{ app_package | js_str }}; // the app under test
const FOREGROUND = 4; // Appium's app state: running in the foreground

export default class BasePage {
    /**
     * @param {{ '{' }} screen: string, identity: ?string, locators: Object<string, string[]> {{ '}' }} page
     */
    constructor({ screen, identity, locators }) {
        this.screen = screen;
        this.identity = identity;
        this.locators = locators;
    }

    /** Whether this screen is the one on display, proven by an element only it has. */
    async isDisplayed() {
        if (this.identity === null) {
            throw new Error(`${this.constructor.name} has no element distinctive enough to identify it`);
        }
        return this._isVisible(this.identity);
    }

    /** Whether the app under test is still up in the foreground — it did not crash. */
    async isAppRunning() {
        return (await driver.queryAppState(APP)) === FOREGROUND;
    }

    /** One pass over the element's ranked selectors, no waiting. */
    async _locate(name) {
        for (const selector of this.locators[name]) {
            const element = await $(selector);
            if (await element.isExisting()) {
                return element;
            }
        }
        return null;
    }

    /** The element, waiting for it to appear and scrolling to reach it if needed. */
    async _find(name) {
        let found = null;
        try {
            await driver.waitUntil(async () => (found = await this._locate(name)) !== null, {
                timeout: TIMEOUT,
                interval: POLL,
            });
            return found;
        } catch {
            // not on screen yet — it may be below the fold
        }
        for (let i = 0; i < SCROLL_TRIES; i += 1) {
            await this._scrollDown();
            found = await this._locate(name);
            if (found) {
                return found;
            }
        }
        throw new Error(`'${name}' not found on the ${this.screen} screen within ${TIMEOUT / 1000}s`);
    }

    async _isVisible(name) {
        try {
            return await (await this._find(name)).isDisplayed();
        } catch {
            return false;
        }
    }

    /** Whether the element is absent — returns the moment it is, not after the full timeout. */
    async _isGone(name) {
        try {
            await driver.waitUntil(async () => (await this._locate(name)) === null, {
                timeout: TIMEOUT,
                interval: POLL,
            });
            return true;
        } catch {
            return false;
        }
    }

    async _text(name) {
        return (await this._find(name)).getText();
    }

    async _isEnabled(name) {
        return (await this._find(name)).isEnabled();
    }

    /** Press the system Back. */
    async goBack() {
        await driver.back();
        await this._settle();
    }

    async _tap(name) {
        await (await this._find(name)).click();
        await this._settle();
    }

    async _type(name, value) {
        const field = await this._find(name);
        await field.clearValue(); // replace, don't append to whatever the field held
        await field.setValue(value);
        await this._settle();
    }

    async _settle() {
        try {
            await driver.waitUntil(async () => !(await (await $(BUSY)).isExisting()), {
                timeout: SETTLE_TIMEOUT,
                interval: POLL,
            });
        } catch {
            // a stuck spinner is tolerated, not failed
        }
        try {
            if (await driver.isKeyboardShown()) {
                await driver.hideKeyboard();
            }
        } catch {
            // no keyboard to dismiss
        }
    }

    async _scrollDown() {
{% if ios %}
        await driver.execute('mobile: scroll', { direction: 'down' });
{% else %}
        const { width, height } = await driver.getWindowSize();
        await driver.execute('mobile: scrollGesture', {
            left: Math.round(width * 0.1),
            top: Math.round(height * 0.2),
            width: Math.round(width * 0.8),
            height: Math.round(height * 0.6),
            direction: 'down',
            percent: 0.8,
        });
{% endif %}
    }
}
