/**
 * WebdriverIO config — auto-generated by Mobiscout. Regenerate rather than hand-edit.
 *
 * Fast by design: each worker keeps ONE Appium session for its specs (opening a session costs
 * 5-10 s) and every test starts from a cold restart of the app (~1-2 s), so each test still
 * begins clean. The appium service starts the Appium server for you.
 */

{% if multi %}
/** Which platform this run drives — one suite serves both (MOBISCOUT_PLATFORM: android | ios). */
const PLATFORM = (process.env.MOBISCOUT_PLATFORM ?? {{ platforms[0] | js_str }}).toLowerCase();
const APP = PLATFORM === 'ios' ? {{ apps["ios"].app_id | js_str }} : {{ apps["android"].app_id | js_str }};

const CAPABILITIES = {
    ios: {
        platformName: 'iOS',
        'appium:automationName': 'XCUITest',
        'appium:bundleId': APP,
{% if apps["ios"].launch_args %}
        'appium:processArguments': { args: {{ apps["ios"].launch_args | js_list }} },
{% endif %}
        // Don't wait for the UI to go idle after every command: a live app rarely does.
        'appium:settings[waitForIdleTimeout]': 0,
        'appium:settings[animationCoolOffTimeout]': 0,
        'appium:noReset': true, // keep app data; each test restarts the app itself (below)
    },
    android: {
        platformName: 'Android',
        'appium:automationName': 'UiAutomator2',
        'appium:appPackage': APP,
{% if apps["android"].app_activity %}
        'appium:appActivity': {{ apps["android"].app_activity | js_str }},
{% endif %}
        'appium:disableWindowAnimation': true, // animations only cost time
        // Don't wait for the UI to go idle after every command: a live app rarely does, and
        // UiAutomator2 would otherwise stall up to 10 s per command.
        'appium:settings[waitForIdleTimeout]': 100,
        'appium:noReset': true, // keep app data; each test restarts the app itself (below)
    },
};
{% else %}
const APP = {{ app_package | js_str }};
{% endif %}

/**
 * Reopen the session if it no longer answers (Appium or the driver crashed): one crash costs
 * one test, not every test after it.
 */
async function ensureAlive() {
    try {
        await driver.queryAppState(APP);
    } catch {
        await driver.reloadSession();
    }
}

export const config = {
    runner: 'local',
    port: 4723,
{% if cucumber %}
    specs: ['./features/**/*.feature'],
{% else %}
    specs: ['./test/specs/**/*.e2e.js'],
{% endif %}
    maxInstances: 1,
{% if multi %}
    capabilities: [CAPABILITIES[PLATFORM]],
{% else %}
    capabilities: [
        {
{% if ios %}
            platformName: 'iOS',
            'appium:automationName': 'XCUITest',
            'appium:bundleId': APP,
{% if launch_args %}
            'appium:processArguments': { args: {{ launch_args | js_list }} },
{% endif %}
            // Don't wait for the UI to go idle after every command: a live app rarely does.
            'appium:settings[waitForIdleTimeout]': 0,
            'appium:settings[animationCoolOffTimeout]': 0,
{% else %}
            platformName: 'Android',
            'appium:automationName': 'UiAutomator2',
            'appium:appPackage': APP,
{% if app_activity %}
            'appium:appActivity': {{ app_activity | js_str }},
{% endif %}
            'appium:disableWindowAnimation': true, // animations only cost time
            // Don't wait for the UI to go idle after every command: a live app rarely does, and
            // UiAutomator2 would otherwise stall up to 10 s per command.
            'appium:settings[waitForIdleTimeout]': 100,
{% endif %}
            'appium:noReset': true, // keep app data; each test restarts the app itself (below)
        },
    ],
{% endif %}
    services: ['appium'],
{% if cucumber %}
    framework: 'cucumber',
    reporters: ['spec'],
{% if multi %}
    cucumberOpts: {
        require: ['./features/step-definitions/*.steps.js'],
        timeout: 90000,
        // One suite, both platforms: leave out what only the other platform does.
        tags: PLATFORM === 'ios' ? 'not @android' : 'not @ios',
    },
{% else %}
    cucumberOpts: { require: ['./features/step-definitions/*.steps.js'], timeout: 90000 },
{% endif %}

    /** A fresh app for every scenario on the worker's shared session. */
    beforeScenario: async () => {
{% else %}
    framework: 'mocha',
    reporters: ['spec'],
    mochaOpts: { ui: 'bdd', timeout: 90000 },

    /** A fresh app for every test on the worker's shared session. */
    beforeTest: async () => {
{% endif %}
        await ensureAlive();
        try {
            await driver.terminateApp(APP);
        } catch {
            // the app was not running
        }
        await driver.activateApp(APP);
    },
};
