/*
 * {{ model.name }} — auto-generated by Mobiscout.
{% if model.description %}
 * {{ model.description }}
{% endif %}
 * App under test: {{ model.app_package }}
 * DO NOT EDIT BY HAND — regenerate from the recorded flow instead.
 *
 * WebdriverIO mobile spec (Mocha). Requires an Appium session configured in
{% if model.platform.value == "ios" %}
 * wdio.conf.js with platformName 'iOS', automationName 'XCUITest',
 * 'appium:bundleId' = {{ model.app_package }}.
{% else %}
 * wdio.conf.js with platformName 'Android', automationName 'UiAutomator2',
 * 'appium:appPackage' = {{ model.app_package }}.
{% endif %}
 */

const APP_PACKAGE = {{ model.app_package | js_str }};
// Condition-based wait budget (ms) — poll for the element instead of a fixed
// pause, so specs stay in sync with async UI without flaking at machine speed.
const TIMEOUT = 10000;
// How many times find() scrolls looking for an off-screen element before giving up.
const SCROLL_TRIES = 4;

// One scroll-down gesture — used by find() to bring a below-the-fold element into view.
async function scrollDown() {
{% if model.platform.value == "ios" %}
    await driver.execute('mobile: scroll', { direction: 'down' });
{% else %}
    const scrollSize = await driver.getWindowSize();
    await driver.execute('mobile: scrollGesture', { left: Math.round(scrollSize.width * 0.1), top: Math.round(scrollSize.height * 0.2), width: Math.round(scrollSize.width * 0.8), height: Math.round(scrollSize.height * 0.6), direction: 'down', percent: 0.8 });
{% endif %}
}

// One pass over the ranked selectors — no waiting.
async function locate(selectors) {
    for (const selector of selectors) {
        const el = await driver.$(selector);
        if (await el.isExisting()) {
            return el;
        }
    }
    return null;
}

// Locate an element, waiting for it to appear and self-healing through ranked
// selectors — each poll tries every selector until one exists or we time out. On a
// miss, scroll and retry: a control below the fold is not a missing control, and the
// same crawl must not pass in one target and fail in another over that.
async function find(selectors) {
    let found = null;
    try {
        await driver.waitUntil(
            async () => {
                found = await locate(selectors);
                return found !== null;
            },
            { timeout: TIMEOUT, interval: 300 }
        );
        return found;
    } catch (e) {
        // not on screen yet — it may just need scrolling into view
    }
    for (let i = 0; i < SCROLL_TRIES; i += 1) {
        await scrollDown();
        found = await locate(selectors);
        if (found) {
            return found;
        }
    }
    throw new Error(`No selector matched within ${TIMEOUT}ms + ${SCROLL_TRIES} scrolls: ${selectors.join(', ')}`);
}

// A generic loading indicator (no app-specific knowledge) — used by settle().
const BUSY = {% if model.platform.value == "ios" %}'//XCUIElementTypeActivityIndicator'{% else %}'//android.widget.ProgressBar'{% endif %};

// Middle beat of act -> wait-busy-clears -> assert: after an action that triggers a
// transition, wait for a loading/activity indicator to disappear so the next step
// doesn't act on a mid-transition screen. A no-op when nothing is spinning; a stuck
// indicator is tolerated rather than failing the spec.
async function settle() {
    try {
        await driver.waitUntil(async () => (await driver.$$(BUSY)).length === 0, { timeout: TIMEOUT, interval: 300 });
    } catch (e) {
        // tolerate a persistent indicator
    }
}

// Reset app state before each test so cases stay independent — one WebdriverIO
// session is shared across the file, so without this a test would inherit whatever
// data an earlier test created (e.g. "list is empty" fails after a case that added a
// row). Mirrors the Python/Java/Kotlin kits. Set MOBISCOUT_KEEP_APP_DATA=1 to skip
// it for an app that needs a provisioned account.
async function resetApp() {
    if (process.env.MOBISCOUT_KEEP_APP_DATA === '1') {
        return;
    }
    try {
        await driver.execute('mobile: clearApp', { {% if model.platform.value == "ios" %}bundleId{% else %}appId{% endif %}: APP_PACKAGE });
    } catch (e) {
        // clearApp isn't supported by every driver/version — tolerate and rely on relaunch.
    }
    await driver.activateApp(APP_PACKAGE);
}

{% for case in model.cases %}
describe({{ model.name | js_str }}, () => {
    beforeEach(resetApp);
    it({{ case.name | js_str }}, async () => {
{% for step in case.steps %}
{% if step.description %}
        // {{ step.description | single_line }}
{% endif %}
{% if step.action.value == "launch" %}
        await driver.activateApp(APP_PACKAGE);
{% elif step.action.value == "tap" %}
        await (await find({{ step.selector | selector_array }})).click();
{% elif step.action.value == "type" %}
        await (await find({{ step.selector | selector_array }})).setValue({{ step.text | js_str }});
{% elif step.action.value == "swipe" %}
{% if model.platform.value == "ios" %}
        await driver.execute('mobile: swipe', { direction: {{ (step.direction or "up") | js_str }} });
{% else %}
        {
            const swipeSize = await driver.getWindowSize();
            await driver.execute('mobile: swipeGesture', { left: Math.round(swipeSize.width * 0.1), top: Math.round(swipeSize.height * 0.1), width: Math.round(swipeSize.width * 0.8), height: Math.round(swipeSize.height * 0.8), direction: {{ (step.direction or "up") | js_str }}, percent: 0.75 });
        }
{% endif %}
{% elif step.action.value == "back" %}
        await driver.back();
{% elif step.action.value == "long_press" %}
{% if model.platform.value == "ios" %}
        await driver.execute('mobile: touchAndHold', { elementId: (await find({{ step.selector | selector_array }})).elementId, duration: 1.0 });
{% else %}
        await driver.execute('mobile: longClickGesture', { elementId: (await find({{ step.selector | selector_array }})).elementId, duration: 1000 });
{% endif %}
{% elif step.action.value == "scroll_to" %}
{% if model.platform.value == "ios" %}
        await driver.execute('mobile: scroll', { predicateString: {{ ('name == "' ~ ((step.selector.description or step.selector.value) | ua_escape) ~ '" OR label == "' ~ ((step.selector.description or step.selector.value) | ua_escape) ~ '"') | js_str }}, toVisible: true });
{% else %}
        await $({{ ('android=new UiScrollable(new UiSelector().scrollable(true)).scrollIntoView(new UiSelector().textContains("' ~ ((step.selector.description or step.selector.value) | ua_escape) ~ '"))') | js_str }});
{% endif %}
{% elif step.action.value == "deep_link" %}
{% if model.platform.value == "ios" %}
        await driver.url({{ step.text | js_str }});
{% else %}
        await driver.execute('mobile: deepLink', { url: {{ step.text | js_str }}, package: APP_PACKAGE });
{% endif %}
{% elif step.action.value == "press_key" %}
{% if model.platform.value == "ios" %}
        // UNSUPPORTED on iOS: no hardware keycode equivalent for {{ step.text | single_line }}; press the key via the on-screen keyboard instead.
{% else %}
        await driver.pressKeyCode({{ step.text | keycode }});
{% endif %}
{% elif step.action.value == "switch_context" %}
{% if step.text == "web" %}
        await driver.switchContext((await driver.getContexts()).find((c) => String(c).toUpperCase().includes('WEBVIEW')));
{% else %}
        await driver.switchContext('NATIVE_APP');
{% endif %}
{% elif step.action.value == "wait" %}
        // Condition-based: wait for the screen to render rather than a fixed pause.
        await driver.waitUntil(async () => (await driver.$$('//*')).length > 0, { timeout: {{ (step.timeout | int or 5) * 1000 }}, interval: 300 });
{% elif step.action.value == "assert" %}
{% if step.assertion.value == "visible" %}
        await expect(await find({{ step.selector | selector_array }})).toBeDisplayed();
{% elif step.assertion.value == "text_equals" %}
        await expect(await find({{ step.selector | selector_array }})).toHaveText({{ step.expected | js_str }});
{% elif step.assertion.value == "enabled" %}
        await expect(await find({{ step.selector | selector_array }})).toBeEnabled();
{% endif %}
{% endif %}
{% if step.action.value in ("tap", "type", "swipe", "back", "long_press", "deep_link", "press_key") %}
        await settle();
{% endif %}
{% endfor %}
    });
});

{% endfor %}
